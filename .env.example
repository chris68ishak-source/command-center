# ─────────────────────────────────────────────
#  Pro Touch Command Center — Environment Vars
#  Copy this to .env.local for local dev.
#  Add all of these to Vercel Environment Variables
#  (Settings → Environment Variables in your Vercel project)
# ─────────────────────────────────────────────

# Anthropic (Claude API)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (SMS sending)
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...   # Your Twilio phone number

# Company Config (change per client deployment)
COMPANY_NAME=Pro Touch Construction
COMPANY_PHONE=+16045550000
COMPANY_CITY=Burnaby, BC
COMPANY_SERVICES=decks,fences,renovations,landscaping
OWNER_NAME=Chris

# Google Review Link
# Get from: Google Business Profile → Get more reviews → Share review form
GOOGLE_REVIEW_LINK=https://g.page/r/YOUR_PLACE_ID/review

# Cron Security (generate a random string, add to Vercel too)
CRON_SECRET=your-random-secret-here
